From 58aaa4d3ce057b7a1f89c84108a53f5742d340bc Mon Sep 17 00:00:00 2001
From: kylieeXD <khayloaftck@gmail.com>
Date: Sun, 24 May 2026 18:02:04 +0700
Subject: [PATCH 2/8] Support third party galleries

Signed-off-by: kylieeXD <khayloaftck@gmail.com>
---
 smali/B/x2.smali                      | 7 ++-----
 smali/com/android/camera/Camera.smali | 6 +++---
 smali_classes2/rd/d.smali             | 2 +-
 3 files changed, 6 insertions(+), 9 deletions(-)

diff --git a/smali/B/x2.smali b/smali/B/x2.smali
index 365923be..fd042737 100644
--- a/smali/B/x2.smali
+++ b/smali/B/x2.smali
@@ -85,7 +85,7 @@
 
     const/4 v4, 0x0
 
-    const-string v5, "com.android.camera.action.REVIEW"
+    const-string v5, "android.provider.action.REVIEW"
 
     if-eqz v1, :cond_0
 
@@ -129,7 +129,7 @@
     :cond_1
     new-array v1, v4, [Ljava/lang/Object;
 
-    const-string v6, "gotoGallery: com.android.camera.action.REVIEW"
+    const-string v6, "gotoGallery: android.provider.action.REVIEW"
 
     invoke-static {v3, v6, v1}, Lcom/android/camera/log/Log;->d(Ljava/lang/String;Ljava/lang/String;[Ljava/lang/Object;)V
 
@@ -138,9 +138,6 @@
     invoke-direct {v1, v5, p2}, Landroid/content/Intent;-><init>(Ljava/lang/String;Landroid/net/Uri;)V
 
     :goto_0
-    const-string p2, "com.miui.gallery"
-
-    invoke-virtual {v1, p2}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;
 
     const-string p2, "from_MiuiCamera"
 
diff --git a/smali/com/android/camera/Camera.smali b/smali/com/android/camera/Camera.smali
index b6204a51..cb3c3fbb 100644
--- a/smali/com/android/camera/Camera.smali
+++ b/smali/com/android/camera/Camera.smali
@@ -11886,7 +11886,7 @@
 
     const-string p1, "gotoGallery: no gallery"
 
-    const-string v2, "com.miui.gallery"
+    const-string v2, "android.intent.category.APP_GALLERY"
 
     if-eqz p0, :cond_f
 
@@ -11907,7 +11907,7 @@
 
     invoke-direct {p0, v3}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V
 
-    invoke-virtual {p0, v2}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;
+    invoke-virtual {p0, v2}, Landroid/content/Intent;->addCategory(Ljava/lang/String;)Landroid/content/Intent;
 
     const-string v2, "from_MiuiCamera"
 
@@ -11948,7 +11948,7 @@
 
     invoke-direct {p0, v0}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V
 
-    invoke-virtual {p0, v2}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;
+    invoke-virtual {p0, v2}, Landroid/content/Intent;->addCategory(Ljava/lang/String;)Landroid/content/Intent;
 
     invoke-virtual {v4, p0}, Landroid/content/Context;->startActivity(Landroid/content/Intent;)V
 
diff --git a/smali_classes2/rd/d.smali b/smali_classes2/rd/d.smali
index 2640bc8d..50326973 100644
--- a/smali_classes2/rd/d.smali
+++ b/smali_classes2/rd/d.smali
@@ -133,7 +133,7 @@
 
     if-nez v3, :cond_1
 
-    const/4 v3, 0x4
+    const/4 v3, 0x2
 
     :goto_2
     if-eqz v3, :cond_2
-- 
